const monthNames = ['Styczeń','Luty','Marzec','Kwiecień','Maj','Czerwiec','Lipiec','Sierpień','Wrzesień','Październik','Listopad','Grudzień'];

const calendarMonth = document.getElementById('calendarMonth');

if (calendarMonth) {
  const calendarDays = document.getElementById('calendarDays');
  const selectedDateLabel = document.getElementById('selectedDate');
  const selectedInfo = document.getElementById('selectedInfo');
  const bookingButton = document.getElementById('bookingButton');
  const prevMonthButton = document.getElementById('prevMonth');
  const nextMonthButton = document.getElementById('nextMonth');
  const bookingForm = document.getElementById('bookingForm');
  const locationSelect = document.getElementById('locationSelect');
  const otherLocationLabel = document.getElementById('otherLocationLabel');
  const otherLocationInput = document.getElementById('otherLocation');
  const eventsList = document.getElementById('events-list');

  let selectedDate = null;
  const today = new Date();
  let currentYear = today.getFullYear();
  let currentMonth = today.getMonth();

  function renderCalendar(year, month) {
    calendarMonth.textContent = `${monthNames[month]} ${year}`;
    calendarDays.innerHTML = '';

    const firstDay = new Date(year, month, 1);
    const firstDayIndex = (firstDay.getDay() + 6) % 7;
    const lastDay = new Date(year, month + 1, 0).getDate();

    for (let i = 0; i < firstDayIndex; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'calendar-day disabled';
      calendarDays.appendChild(emptyCell);
    }

    for (let day = 1; day <= lastDay; day++) {
      const dayButton = document.createElement('button');
      dayButton.type = 'button';
      dayButton.className = 'calendar-day';
      dayButton.textContent = day;
      const dayDate = new Date(year, month, day);
      dayButton.addEventListener('click', () => selectDate(dayDate, dayButton));

      if (selectedDate && selectedDate.getTime() === dayDate.getTime()) {
        dayButton.classList.add('active');
      }

      calendarDays.appendChild(dayButton);
    }
  }

  function selectDate(date, button) {
    selectedDate = date;
    const activeButtons = document.querySelectorAll('.calendar-day.active');
    activeButtons.forEach((btn) => btn.classList.remove('active'));
    if (button) button.classList.add('active');

    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    selectedDateLabel.textContent = date.toLocaleDateString('pl-PL', options);
    selectedInfo.textContent = 'Wypełnij formularz i potwierdź rezerwację.';
    updateBookingState();
  }

  function updateBookingState() {
    if (locationSelect.value === 'Inna') {
      otherLocationInput.required = true;
    } else {
      otherLocationInput.required = false;
    }

    const isFormValid = bookingForm.checkValidity();
    bookingButton.disabled = !(selectedDate && isFormValid);
  }

  function updateLocationField() {
    if (locationSelect.value === 'Inna') {
      otherLocationLabel.classList.remove('hidden');
      otherLocationInput.focus();
    } else {
      otherLocationLabel.classList.add('hidden');
      otherLocationInput.value = '';
    }
    updateBookingState();
  }

  function changeMonth(offset) {
    currentMonth += offset;
    if (currentMonth < 0) {
      currentMonth = 11;
      currentYear -= 1;
    }
    if (currentMonth > 11) {
      currentMonth = 0;
      currentYear += 1;
    }
    selectedDate = null;
    selectedDateLabel.textContent = 'Wybierz dzień z kalendarza';
    selectedInfo.textContent = 'Kliknij termin, aby zapisać się na spacer lub kurs.';
    bookingButton.disabled = true;
    renderCalendar(currentYear, currentMonth);
  }

  prevMonthButton.addEventListener('click', () => changeMonth(-1));
  nextMonthButton.addEventListener('click', () => changeMonth(1));
  locationSelect.addEventListener('change', updateLocationField);

  bookingForm.addEventListener('input', updateBookingState);
  bookingForm.addEventListener('change', updateBookingState);

  bookingForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!selectedDate || !bookingForm.checkValidity()) {
      updateBookingState();
      return;
    }

    const formData = new FormData(bookingForm);
    const dateString = selectedDate.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });
    const selectedLocation = formData.get('location') === 'Inna' ? formData.get('otherLocation') : formData.get('location');

    const message = `Rezerwacja:\nData: ${dateString}\nGodzina: ${formData.get('timeSlot')}\nRodzaj zajęć: ${formData.get('serviceType')}\nLokalizacja: ${selectedLocation}\nImię: ${formData.get('firstName')} ${formData.get('lastName')}\nImię psa: ${formData.get('dogName')}\nWiek psa: ${formData.get('dogAge')}\nPłeć psa: ${formData.get('dogGender')}`;

    alert(message + "\n\nDziękujemy! Skontaktujemy się wkrótce w celu potwierdzenia.");

    const endpoint = bookingForm.dataset.formspree;
    if (endpoint && endpoint.includes('formspree.io')) {
      fetch(endpoint, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      }).then(response => {
        if (response.ok) {
          bookingForm.reset();
        }
      }).catch(() => {
        // ignoring network errors for now
      });
    }
  });

  function loadEvents() {
    if (!eventsList) return;
    fetch('data/events.json')
      .then(res => res.json())
      .then(data => {
        eventsList.innerHTML = '';
        if (!data || data.length === 0) {
          eventsList.textContent = 'Brak zaplanowanych terminów.';
          return;
        }

        data.forEach(ev => {
          const item = document.createElement('div');
          item.className = 'event-item';
          const when = new Date(ev.date);
          item.innerHTML = `<strong>${ev.title}</strong><br>${when.toLocaleDateString('pl-PL')} ${ev.time} — ${ev.place}`;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = 'Zapisz się';
          btn.addEventListener('click', () => {
            selectedDate = new Date(ev.date + 'T' + (ev.time || '10:00'));
            selectedDateLabel.textContent = selectedDate.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });
            const timeInput = bookingForm.querySelector('input[name="timeSlot"]');
            if (timeInput && ev.time) timeInput.value = ev.time;
            const serviceSelect = bookingForm.querySelector('select[name="serviceType"]');
            if (serviceSelect && ev.type) serviceSelect.value = ev.type;
            const locationSelectField = bookingForm.querySelector('select[name="location"]');
            if (locationSelectField) locationSelectField.value = ev.place || locationSelectField.value;
            selectedInfo.textContent = 'Wypełnij formularz i potwierdź rezerwację.';
            bookingButton.disabled = false;
            bookingForm.scrollIntoView({ behavior: 'smooth' });
          });

          item.appendChild(btn);
          eventsList.appendChild(item);
        });
      })
      .catch(() => { eventsList.textContent = 'Nie udało się załadować terminów.'; });
  }

  renderCalendar(currentYear, currentMonth);
  loadEvents();
}
