// ── Odczyt zakładki "Grafik" ──────────────────────────────────────────
// Kolumny: Dzień tygodnia (Poniedziałek / YYYY-MM-DD) | Dostępne godziny (np. "18:00, 19:00, 20:00") |
//          Zajęcia (opcjonalnie, np. "Posłuszeństwo, Rally-o")
// Pusta trzecia kolumna = w tych godzinach można zapisać się na wszystkie zajęcia.
// Wiersze z tym samym dniem / tą samą datą są scalane: godziny się sumują, a ograniczenie
// do zajęć dotyczy wyłącznie godzin z tego samego wiersza.
function getScheduleConfig(spreadsheet) {
  var sheet = spreadsheet.getSheetByName("Grafik");
  var defaultHours = ['18:00', '19:00', '20:00'];
  if (!sheet) {
    return {
      defaultHours: defaultHours,
      days: {},
      serviceHours: {}
    };
  }

  var tz = spreadsheet.getSpreadsheetTimeZone() || "Europe/Warsaw";
  var data = sheet.getDataRange().getValues();
  var daysConfig = {};
  var serviceHours = {};
  var generalDefault = defaultHours;

  for (var i = 1; i < data.length; i++) {
    var rawKey = data[i][0];
    if (rawKey === undefined || rawKey === null || String(rawKey).trim() === '') continue;

    // Obsługa daty zapisanej jako obiekt Date w arkuszu
    var key = '';
    if (rawKey instanceof Date || (typeof rawKey === 'object' && typeof rawKey.getTime === 'function')) {
      key = Utilities.formatDate(rawKey, tz, "yyyy-MM-dd");
    } else {
      key = String(rawKey).trim().toLowerCase();
    }

    var hoursRaw = String(data[i][1] || '').trim();
    var hoursList = [];
    if (hoursRaw) {
      hoursList = hoursRaw.split(/[;,]/).map(function(h) {
        return normalizeTime(h.trim());
      }).filter(Boolean);
    }
    var servicesList = splitList(data[i][2]);

    if (key === 'domyślne' || key === 'domyslne' || key === 'default') {
      if (hoursList.length > 0) generalDefault = hoursList;
      addServiceRestrictions_(serviceHours, 'default', generalDefault, servicesList);
    } else {
      // Przypisujemy listę (nawet jeśli pusta, co oznacza dzień wolny / brak terminów)
      if (!daysConfig[key]) daysConfig[key] = [];
      for (var h = 0; h < hoursList.length; h++) {
        if (daysConfig[key].indexOf(hoursList[h]) === -1) daysConfig[key].push(hoursList[h]);
      }
      daysConfig[key].sort(compareHours_);
      addServiceRestrictions_(serviceHours, key, hoursList, servicesList);
    }
  }

  return {
    defaultHours: generalDefault.slice().sort(compareHours_),
    days: daysConfig,
    serviceHours: serviceHours
  };
}

// Zapisuje w mapie ograniczenie „w tych godzinach tylko te zajęcia”.
// Wiersz bez nazw zajęć nie nakłada żadnego ograniczenia.
function addServiceRestrictions_(serviceHours, key, hoursList, servicesList) {
  if (!servicesList || servicesList.length === 0) return;
  if (!serviceHours[key]) serviceHours[key] = {};

  for (var i = 0; i < hoursList.length; i++) {
    var hour = hoursList[i];
    if (!serviceHours[key][hour]) serviceHours[key][hour] = [];
    for (var s = 0; s < servicesList.length; s++) {
      if (!containsName_(serviceHours[key][hour], servicesList[s])) {
        serviceHours[key][hour].push(servicesList[s]);
      }
    }
  }
}

function compareHours_(a, b) {
  return adminMinutes_(a) - adminMinutes_(b);
}

// Porównanie nazw zajęć — bez wielkości liter i zbędnych spacji.
function containsName_(list, name) {
  var target = String(name === undefined || name === null ? '' : name).trim().toLowerCase();
  for (var i = 0; i < (list || []).length; i++) {
    if (String(list[i]).trim().toLowerCase() === target) return true;
  }
  return false;
}

// "2026-11-05" → "czwartek" (klucz taki, jak w zakładce Grafik)
function weekdayKeyForDate_(dateStr) {
  var parts = String(dateStr || '').split('-');
  if (parts.length !== 3) return '';
  var day = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10)).getDay();
  return ADMIN_DAY_NAMES[day === 0 ? 6 : day - 1].toLowerCase();
}

// Godziny obowiązujące danego dnia (data → dzień tygodnia → godziny domyślne).
function getDaySchedule_(schedule, dateStr) {
  if (schedule.days && schedule.days[dateStr] !== undefined) {
    return { key: dateStr, hours: schedule.days[dateStr] };
  }

  var weekdayKey = weekdayKeyForDate_(dateStr);
  if (weekdayKey && schedule.days && schedule.days[weekdayKey] !== undefined) {
    return { key: weekdayKey, hours: schedule.days[weekdayKey] };
  }

  return { key: 'default', hours: schedule.defaultHours || [] };
}

// Czy o tej godzinie można zapisać się na te konkretne zajęcia?
// Ostatnia linia obrony, gdy ktoś ma otwartą stronę z nieaktualnym grafikiem.
function checkServiceSlot_(schedule, dateStr, timeStr, serviceName) {
  var day = getDaySchedule_(schedule, dateStr);

  if (!containsName_(day.hours, timeStr)) {
    return {
      ok: false,
      message: 'Termin ' + dateStr + ' o godz. ' + timeStr + ' nie jest już dostępny — odśwież stronę i wybierz inną godzinę.'
    };
  }

  var restrictions = (schedule.serviceHours && schedule.serviceHours[day.key]) || {};
  var allowed = restrictions[timeStr] || [];

  if (allowed.length > 0 && !containsName_(allowed, serviceName)) {
    return {
      ok: false,
      message: 'O godzinie ' + timeStr + ' w dniu ' + dateStr + ' odbywają się inne zajęcia (' + allowed.join(', ') + ').'
    };
  }

  return { ok: true };
}

// Bezpieczne formatowanie daty z arkusza
function formatSheetDate(val, tz) {
  if (!val) return '';
  if (val instanceof Date || (typeof val === 'object' && typeof val.getTime === 'function')) {
    return Utilities.formatDate(val, tz, "yyyy-MM-dd");
  }
  var str = String(val).trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) {
    return str;
  }
  var parsed = new Date(str);
  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(parsed, tz, "yyyy-MM-dd");
  }
  return str;
}

// Bezpieczne formatowanie godziny z arkusza
function formatSheetTime(val, tz) {
  if (!val) return '';
  if (val instanceof Date || (typeof val === 'object' && typeof val.getHours === 'function')) {
    return Utilities.formatDate(val, tz, "HH:mm");
  }
  var str = String(val).trim();
  return normalizeTime(str);
}

function normalizeTime(str) {
  if (!str) return '';
  if (/^\d{1,2}:\d{2}$/.test(str)) {
    return str.length === 4 ? '0' + str : str;
  }
  var match = str.match(/(\d{1,2}):(\d{2})(?::\d{2})?/);
  if (match) {
    var h = match[1].length === 1 ? '0' + match[1] : match[1];
    return h + ':' + match[2];
  }
  return str;
}

// ══════════════════════════════════════════════════════════════════════
// PANEL ADMINISTRATORA
// Strona pod tym samym adresem co API: …/exec?page=admin
// Panel pisze do zakładek Grafik i Uslugi, pokazuje zapisy i pozwala je
// odwołać. Dostęp chroni PIN z właściwości skryptu (ADMIN_PIN), opcjonalnie
// dodatkowo sprawdzany jest adres zalogowanego konta (ADMIN_EMAIL).
// ══════════════════════════════════════════════════════════════════════

var ADMIN_DAY_NAMES = ['Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota', 'Niedziela'];
var ADMIN_TIME_RE   = /^([01]\d|2[0-3]):[0-5]\d$/;
var ADMIN_DATE_RE   = /^\d{4}-\d{2}-\d{2}$/;
// CacheService trzyma wpisy maksymalnie 6 godzin — dłuższa sesja i tak by nie przetrwała.
var ADMIN_SESSION_SECONDS = 6 * 60 * 60;

var ADMIN_DIACRITICS = { 'ą': 'a', 'ć': 'c', 'ę': 'e', 'ł': 'l', 'ń': 'n', 'ó': 'o', 'ś': 's', 'ź': 'z', 'ż': 'z' };

function adminNormalizeKey_(text) {
  return String(text || '').toLowerCase().replace(/[ąćęłńóśźż]/g, function (ch) {
    return ADMIN_DIACRITICS[ch] || ch;
  });
}

function adminWeekdayIndex_(key) {
  var normalized = adminNormalizeKey_(key);
  for (var i = 0; i < ADMIN_DAY_NAMES.length; i++) {
    if (adminNormalizeKey_(ADMIN_DAY_NAMES[i]) === normalized) return i;
  }
  return -1;
}

function adminMinutes_(hour) {
  var parts = String(hour || '').split(':');
  return (parseInt(parts[0], 10) || 0) * 60 + (parseInt(parts[1], 10) || 0);
}

// "18:00, 19:30" → ['18:00', '19:30'] — posortowane, bez duplikatów i śmieci
function adminParseHours_(value) {
  var raw = String(value || '').trim();
  if (!raw) return [];

  var seen = {};
  var out = [];
  raw.split(/[;,]/).forEach(function (chunk) {
    var hour = normalizeTime(String(chunk).trim());
    if (!ADMIN_TIME_RE.test(hour) || seen[hour]) return;
    seen[hour] = true;
    out.push(hour);
  });
  out.sort(function (a, b) { return adminMinutes_(a) - adminMinutes_(b); });
  return out;
}

// Lista godzin przysłana z panelu → posortowana, poprawna lista (albo [])
function adminCleanHours_(list) {
  if (!list || !list.length) return [];
  return adminParseHours_(list.join(','));
}

// ── Dostęp ─────────────────────────────────────────────────────────────

function adminProps_() {
  return PropertiesService.getScriptProperties();
}

function adminPin_() {
  return String(adminProps_().getProperty('ADMIN_PIN') || '').trim();
}

function adminAllowedEmail_() {
  return String(adminProps_().getProperty('ADMIN_EMAIL') || '').trim().toLowerCase();
}

// Adres osoby otwierającej panel. Przy zwykłym Gmailu bywa pusty —
// wtedy zostaje sam PIN, dlatego nie wymagamy go do działania panelu.
function adminVisitorEmail_() {
  try {
    return String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();
  } catch (err) {
    return '';
  }
}

function adminSessionKey_(token) {
  return 'admin_session_' + String(token || '');
}

// Sprawdza PIN i wydaje krótkotrwały token sesji (PIN nie jest zapisywany na urządzeniu).
function adminAuth(pin) {
  var expected = adminPin_();
  if (!expected) {
    return {
      status: 'error',
      code: 'no-pin',
      message: 'Panel nie ma jeszcze PIN-u. Dodaj właściwość skryptu ADMIN_PIN (Ustawienia projektu → Właściwości skryptu) i wdróż nową wersję.'
    };
  }

  if (String(pin || '').trim() !== expected) {
    return { status: 'error', code: 'bad-pin', message: 'Nieprawidłowy PIN.' };
  }

  var allowed = adminAllowedEmail_();
  var visitor = adminVisitorEmail_();
  if (allowed && visitor && visitor !== allowed) {
    return { status: 'error', code: 'bad-user', message: 'To konto Google nie ma dostępu do panelu.' };
  }

  var token = Utilities.getUuid();
  CacheService.getScriptCache().put(adminSessionKey_(token), '1', ADMIN_SESSION_SECONDS);

  return { status: 'success', token: token, email: visitor };
}

// Jednorazowa pomoc: uruchom tę funkcję z edytora Apps Script, żeby ustawić PIN.
function ustawPinAdmina() {
  var pin = String(Browser.inputBox('Nowy PIN panelu (co najmniej 4 znaki):') || '').trim();
  if (pin.length < 4) {
    Browser.msgBox('PIN musi mieć co najmniej 4 znaki. Nic nie zmieniono.');
    return;
  }
  adminProps_().setProperty('ADMIN_PIN', pin);
  Browser.msgBox('PIN zapisany. Wdróż nową wersję wdrożenia (Wdróż → Zarządzaj wdrożeniami → Edytuj → Nowa wersja).');
}

function adminCheckAuth_(req) {
  var token = req && req.token;
  var expired = { status: 'error', code: 'auth', message: 'Sesja wygasła — zaloguj się ponownie.' };

  if (!token) return expired;
  if (!CacheService.getScriptCache().get(adminSessionKey_(token))) return expired;

  return null;
}

// Jedyny punkt wejścia panelu — wołany z przeglądarki przez google.script.run.
function adminApi(req) {
  req = req || {};

  var authError = adminCheckAuth_(req);
  if (authError) return authError;

  try {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

    switch (req.action) {
      case 'grafik':        return adminGetGrafik_(spreadsheet);
      case 'saveGrafik':    return adminSaveGrafik_(spreadsheet, req.payload || {});
      case 'uslugi':        return adminGetUslugi_(spreadsheet);
      case 'saveUslugi':    return adminSaveUslugi_(spreadsheet, req.payload || {});
      case 'rezerwacje':    return adminGetRezerwacje_(spreadsheet, req.payload || {});
      case 'cancelBooking': return adminCancelBooking_(spreadsheet, req.payload || {});
      default:              return { status: 'error', message: 'Nieznana akcja: ' + req.action };
    }
  } catch (err) {
    Logger.log('adminApi: ' + err);
    return { status: 'error', message: 'Błąd serwera: ' + err.toString() };
  }
}

// ── Grafik ─────────────────────────────────────────────────────────────

// Zwraca grafik w formie wygodnej dla panelu:
//   default   — godziny domyślne (fallback dla dni bez własnego wpisu) + dozwolone zajęcia
//   weekdays  — wpisy dni tygodnia; BRAK klucza = dzień dziedziczy domyślne
//   dates     — wyjątki na konkretną datę (pusta lista = dzień wolny)
//   extraRows — wiersze, których panel nie rozumie (przepisujemy je bez zmian)
// Pusta lista `services` = w tych godzinach można zapisać się na wszystkie zajęcia.
function adminGetGrafik_(spreadsheet) {
  var result = {
    status: 'success',
    'default': { hours: ['18:00', '19:00', '20:00'], services: [] },
    weekdays: {},
    dates: [],
    extraRows: [],
    services: getServicesConfig(spreadsheet).map(function (s) { return s.name; })
  };

  var sheet = spreadsheet.getSheetByName('Grafik');
  if (!sheet) return result;

  var tz = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Warsaw';
  var data = sheet.getDataRange().getValues();

  for (var i = 1; i < data.length; i++) {
    var rawKey = data[i][0];
    if (rawKey === undefined || rawKey === null || String(rawKey).trim() === '') continue;

    var rawHours = String(data[i][1] || '').trim();
    var hours = adminParseHours_(rawHours);
    var services = adminCleanServices_(data[i][2]);
    var isDateCell = (rawKey instanceof Date)
      || (typeof rawKey === 'object' && typeof rawKey.getTime === 'function')
      || ADMIN_DATE_RE.test(String(rawKey).trim());
    var key = isDateCell ? formatSheetDate(rawKey, tz) : String(rawKey).trim().toLowerCase();

    if (key === 'domyślne' || key === 'domyslne' || key === 'default') {
      if (hours.length > 0) {
        result['default'] = { hours: hours, services: services };
      }
      continue;
    }

    var weekdayIndex = adminWeekdayIndex_(key);
    if (weekdayIndex !== -1) {
      var dayKey = ADMIN_DAY_NAMES[weekdayIndex].toLowerCase();
      if (result.weekdays[dayKey]) {
        // Dwa wiersze na ten sam dzień (ręczna edycja) — sumujemy godziny i zajęcia
        result.weekdays[dayKey] = {
          hours: adminMergeHours_(result.weekdays[dayKey].hours, hours),
          services: adminMergeServices_(result.weekdays[dayKey].services, services)
        };
      } else {
        result.weekdays[dayKey] = { hours: hours, services: services };
      }
      continue;
    }

    if (isDateCell && ADMIN_DATE_RE.test(key)) {
      result.dates.push({ date: key, hours: hours, services: services });
      continue;
    }

    result.extraRows.push([String(rawKey), rawHours, String(data[i][2] || '').trim()]);
  }

  result.dates.sort(function (a, b) {
    if (a.date !== b.date) return a.date < b.date ? -1 : 1;
    return adminMinutes_(a.hours[0] || '') - adminMinutes_(b.hours[0] || '');
  });
  return result;
}

// Lista nazw zajęć z komórki arkusza albo z panelu → bez duplikatów i pustych wartości
function adminCleanServices_(value) {
  var list = value instanceof Array ? value : splitList(value);
  var out = [];
  for (var i = 0; i < list.length; i++) {
    var name = String(list[i] === undefined || list[i] === null ? '' : list[i]).trim();
    if (!name || containsName_(out, name)) continue;
    out.push(name);
  }
  return out;
}

function adminMergeHours_(a, b) {
  var out = (a || []).slice();
  (b || []).forEach(function (hour) {
    if (out.indexOf(hour) === -1) out.push(hour);
  });
  out.sort(compareHours_);
  return out;
}

function adminMergeServices_(a, b) {
  var out = (a || []).slice();
  (b || []).forEach(function (name) {
    if (!containsName_(out, name)) out.push(name);
  });
  return out;
}

function adminSaveGrafik_(spreadsheet, payload) {
  var defaultEntry = payload['default'] || {};
  var defaultHours = adminCleanHours_(defaultEntry.hours || defaultEntry);
  if (defaultHours.length === 0) {
    return {
      status: 'error',
      code: 'validation',
      message: 'Godziny domyślne nie mogą być puste. Zostaw przynajmniej jedną albo oznacz wszystkie dni tygodnia osobno.'
    };
  }

  var defaultServices = adminCleanServices_(defaultEntry.services);
  var availableServices = getServicesConfig(spreadsheet).map(function (s) { return s.name; });
  var unknownServices = [];

  function rememberUnknown(list) {
    (list || []).forEach(function (name) {
      if (!containsName_(availableServices, name) && !containsName_(unknownServices, name)) {
        unknownServices.push(name);
      }
    });
  }

  // Dzień z wpisem (własne godziny lub „wolne”) albo bez wpisu (dziedziczy domyślne).
  var weekdayRows = [];
  var weekdays = payload.weekdays || {};
  for (var i = 0; i < ADMIN_DAY_NAMES.length; i++) {
    var name = ADMIN_DAY_NAMES[i];
    var key = name.toLowerCase();
    if (!Object.prototype.hasOwnProperty.call(weekdays, key)) continue;
    var dayEntry = weekdays[key] || {};
    var dayServices = adminCleanServices_(dayEntry.services);
    rememberUnknown(dayServices);
    weekdayRows.push([
      name,
      adminCleanHours_(dayEntry.hours || dayEntry).join(', '),
      dayServices.join(', ')
    ]);
  }

  rememberUnknown(defaultServices);

  var dateRows = [];
  var seenDates = {};
  (payload.dates || []).forEach(function (entry) {
    var date = String((entry && entry.date) || '').trim();
    if (!ADMIN_DATE_RE.test(date)) return;

    var hours = adminCleanHours_(entry.hours);
    var services = adminCleanServices_(entry.services);
    rememberUnknown(services);

    // Ta sama data z różnymi zajęciami to dwa osobne wiersze (np. spacery rano, salka wieczorem)
    var signature = date + '|' + hours.join(',') + '|' + services.join(',');
    if (seenDates[signature]) return;
    seenDates[signature] = true;

    dateRows.push([date, hours.join(', '), services.join(', ')]);
  });
  dateRows.sort(function (a, b) {
    if (a[0] !== b[0]) return a[0] < b[0] ? -1 : 1;
    return adminMinutes_(String(a[1]).split(',')[0].trim()) - adminMinutes_(String(b[1]).split(',')[0].trim());
  });

  if (unknownServices.length > 0) {
    return {
      status: 'error',
      code: 'validation',
      message: 'Nie ma takich zajęć w ofercie: ' + unknownServices.join(', ') + '. Popraw nazwy w zakładce „Zajęcia” i zapisz grafik jeszcze raz.'
    };
  }

  var extraRows = (payload.extraRows || []).filter(function (row) {
    return row && String(row[0] || '').trim() !== '';
  }).map(function (row) {
    return [String(row[0] || ''), String(row[1] || ''), String(row[2] || '')];
  });

  return adminWithLock_(function () {
    var sheet = spreadsheet.getSheetByName('Grafik') || spreadsheet.insertSheet('Grafik');
    sheet.clearContents();
    sheet.getRange(1, 1, 1, 3).setValues([[
      'Dzień / Data',
      'Godziny (oddzielone przecinkiem)',
      'Zajęcia (puste = wszystkie, oddzielone przecinkiem)'
    ]]);

    var rows = [['Domyślne', defaultHours.join(', '), defaultServices.join(', ')]].concat(weekdayRows, dateRows, extraRows);
    sheet.getRange(2, 1, rows.length, 3).setValues(rows);

    return { status: 'success', rows: rows.length };
  });
}

// ── Oferta (zakładka Uslugi) ───────────────────────────────────────────

function adminGetUslugi_(spreadsheet) {
  var sheet = spreadsheet.getSheetByName('Uslugi');
  var services = getServicesConfig(spreadsheet);
  var list = [];

  for (var i = 0; i < services.length; i++) {
    var s = services[i];
    list.push({
      name: s.name,
      icon: s.icon,
      desc: s.desc,
      maxDogs: s.maxDogs,
      is1on1: s.is1on1,
      locations: s.locations,
      price: s.price,
      duration: s.duration,
      features: s.features
    });
  }

  return { status: 'success', exists: !!sheet, services: list };
}

function adminSaveUslugi_(spreadsheet, payload) {
  var list = payload.services || [];
  if (!list.length) {
    return { status: 'error', code: 'validation', message: 'Potrzebujesz przynajmniej jednego rodzaju zajęć.' };
  }

  var rows = [];
  var seen = {};

  for (var i = 0; i < list.length; i++) {
    var item = list[i] || {};
    var name = String(item.name || '').trim();
    if (!name) {
      return { status: 'error', code: 'validation', message: 'Zajęcia nr ' + (i + 1) + ' nie mają nazwy.' };
    }

    // Dopasowanie slotów działa po nazwie, więc nazwy muszą być unikalne.
    var normalizedName = adminNormalizeKey_(name);
    if (seen[normalizedName]) {
      return { status: 'error', code: 'validation', message: 'Nazwy zajęć muszą być unikalne — „' + name + '” powtarza się.' };
    }
    seen[normalizedName] = true;

    var locations = (item.locations || []).map(function (loc) {
      return String(loc || '').trim();
    }).filter(Boolean);
    if (!locations.length) {
      return { status: 'error', code: 'validation', message: 'Zajęcia „' + name + '” nie mają żadnego miejsca spotkania.' };
    }

    var maxDogs = parseInt(item.maxDogs, 10);
    if (isNaN(maxDogs) || maxDogs < 1) maxDogs = 1;
    var is1on1 = item.is1on1 === true || String(item.is1on1).toUpperCase() === 'TAK' || maxDogs === 1;

    rows.push([
      name,
      String(item.icon || '').trim() || '🐾',
      String(item.desc || '').trim(),
      maxDogs,
      is1on1 ? 'TAK' : 'NIE',
      locations.join('; '),
      String(item.price || '').trim(),
      String(item.duration || '').trim(),
      (item.features || []).map(function (f) { return String(f || '').trim(); }).filter(Boolean).join('; ')
    ]);
  }

  return adminWithLock_(function () {
    var sheet = spreadsheet.getSheetByName('Uslugi') || spreadsheet.insertSheet('Uslugi');
    sheet.clearContents();
    sheet.getRange(1, 1, 1, 9).setValues([[
      'Nazwa', 'Ikona', 'Opis', 'Maks psów', 'Indywidualne',
      'Lokalizacje (; )', 'Cena', 'Czas trwania', 'Co w cenie (; )'
    ]]);
    sheet.getRange(2, 1, rows.length, 9).setValues(rows);

    return { status: 'success', count: rows.length };
  });
}

// ── Zapisy ─────────────────────────────────────────────────────────────

function adminGetRezerwacje_(spreadsheet, payload) {
  var sheet = spreadsheet.getSheetByName('Rezerwacje') || spreadsheet.getActiveSheet();
  var tz = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Warsaw';
  var data = sheet.getDataRange().getValues();
  var from = String(payload.from || '').trim();
  var to = String(payload.to || '').trim();
  var bookings = [];

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var date = formatSheetDate(row[0], tz);
    var time = formatSheetTime(row[2], tz);
    if (!date || !time) continue;
    if (from && date < from) continue;
    if (to && date > to) continue;

    bookings.push({
      row: i + 1,
      date: date,
      time: time,
      service: String(row[3] || '').trim(),
      location: String(row[4] || '').trim(),
      firstName: String(row[5] || '').trim(),
      lastName: String(row[6] || '').trim(),
      email: String(row[7] || '').trim(),
      phone: String(row[8] || '').trim(),
      dogName: String(row[9] || '').trim(),
      dogAge: String(row[10] || '').trim(),
      dogGender: String(row[11] || '').trim(),
      sociability: String(row[12] || '').trim(),
      notes: String(row[13] || '').trim(),
      health: String(row[14] || '').trim(),
      created: row[16] ? Utilities.formatDate(new Date(row[16]), tz, 'yyyy-MM-dd HH:mm') : ''
    });
  }

  bookings.sort(function (a, b) {
    if (a.date !== b.date) return a.date < b.date ? -1 : 1;
    return adminMinutes_(a.time) - adminMinutes_(b.time);
  });

  return { status: 'success', bookings: bookings };
}

function adminCancelBooking_(spreadsheet, payload) {
  var rowNumber = parseInt(payload.row, 10);
  if (!rowNumber || rowNumber < 2) {
    return { status: 'error', code: 'validation', message: 'Nieprawidłowy wiersz rezerwacji.' };
  }

  return adminWithLock_(function () {
    var sheet = spreadsheet.getSheetByName('Rezerwacje') || spreadsheet.getActiveSheet();
    var tz = spreadsheet.getSpreadsheetTimeZone() || 'Europe/Warsaw';

    if (rowNumber > sheet.getLastRow()) {
      return { status: 'error', message: 'Ten zapis już nie istnieje — odśwież listę.' };
    }

    var values = sheet.getRange(rowNumber, 1, 1, 17).getValues()[0];
    var date = formatSheetDate(values[0], tz);
    var time = formatSheetTime(values[2], tz);
    var dogName = String(values[9] || '').trim();

    // Zabezpieczenie przed usunięciem niewłaściwego wiersza, gdy lista się przesunie.
    if (payload.date && date !== String(payload.date).trim()) {
      return { status: 'error', message: 'Lista się zmieniła — odśwież zapisy i spróbuj ponownie.' };
    }
    if (payload.time && time !== normalizeTime(String(payload.time).trim())) {
      return { status: 'error', message: 'Lista się zmieniła — odśwież zapisy i spróbuj ponownie.' };
    }

    sheet.deleteRow(rowNumber);

    // Wydarzenie w Kalendarzu Google usuwamy „best effort” — brak wpisu nie może
    // zablokować odwołania rezerwacji w arkuszu.
    var calendarRemoved = false;
    try {
      calendarRemoved = adminRemoveCalendarEvent_(date, time, dogName);
    } catch (calErr) {
      Logger.log('Błąd usuwania wydarzenia: ' + calErr);
    }

    try {
      logStat_('rezerwacja_odwolana', date + ' ' + time + ' · ' + (values[3] || '') + ' · ' + dogName);
    } catch (logErr) {
      Logger.log('Błąd zapisu statystyki: ' + logErr);
    }

    return { status: 'success', row: rowNumber, calendarRemoved: calendarRemoved };
  });
}

// Szuka w Kalendarzu wydarzenia tej rezerwacji (data + godzina + imię psa).
function adminRemoveCalendarEvent_(date, time, dogName) {
  if (!ADMIN_DATE_RE.test(date) || !dogName) return false;

  var parts = date.split('-');
  var day = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
  var events = CalendarApp.getDefaultCalendar().getEventsForDay(day);

  for (var i = 0; i < events.length; i++) {
    var title = String(events[i].getTitle() || '');
    if (title.indexOf('PsiApsi:') !== 0) continue;
    if (title.indexOf('(' + dogName + ')') === -1) continue;

    var start = events[i].getStartTime();
    var eventTime = normalizeTime(start.getHours() + ':' + start.getMinutes());
    if (adminMinutes_(eventTime) !== adminMinutes_(time)) continue;

    events[i].deleteEvent();
    return true;
  }

  return false;
}

// Wspólna blokada zapisu — dwie osoby klikające „Zapisz” naraz nie mogą
// nadpisać swoich zmian w połowie.
function adminWithLock_(fn) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
  } catch (err) {
    return { status: 'error', message: 'Serwer był zajęty. Spróbuj ponownie.' };
  }

  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}