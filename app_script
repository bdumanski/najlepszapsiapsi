function doPost(e) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: 'Serwer był zajęty. Spróbuj ponownie.' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  try {
    var data = JSON.parse(e.postData.contents);
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = spreadsheet.getSheetByName("Rezerwacje") || spreadsheet.getActiveSheet();
    var tz = spreadsheet.getSpreadsheetTimeZone() || "Europe/Warsaw";
    var allRows = sheet.getDataRange().getValues();

    var requestedDate = String(data.rawDate).trim();
    var requestedTime = normalizeTime(String(data.timeSlot).trim());
    var requestedService = String(data.serviceType || '').toLowerCase();

    // Sprawdzamy konfigurację usług z zakładki Uslugi (jeśli istnieje)
    var servicesConfig = getServicesConfig(spreadsheet);
    var matchedConfig = null;
    for (var s = 0; s < servicesConfig.length; s++) {
      if (servicesConfig[s].name.toLowerCase() === requestedService) {
        matchedConfig = servicesConfig[s];
        break;
      }
    }

    // Domyślne reguły jeśli nie ma w konfiguracji
    var is1on1 = matchedConfig ? matchedConfig.is1on1 : (
      requestedService.indexOf('1-1') !== -1 || 
      requestedService.indexOf('indywidualny') !== -1 || 
      requestedService.indexOf('konsultacj') !== -1
    );
    var maxDogs = matchedConfig ? matchedConfig.maxDogs : (is1on1 ? 1 : 3);

    var existing1on1 = false;
    var existingGroupCount = 0;
    var existingTotal = 0;
    var existingSlotLocation = '';

    for (var i = 1; i < allRows.length; i++) {
      var row = allRows[i];
      var rowDate = formatSheetDate(row[0], tz);
      var rowTime = formatSheetTime(row[2], tz);

      if (rowDate === requestedDate && rowTime === requestedTime) {
        existingTotal++;
        var rowService = String(row[3] || '').trim();
        var rowLocation = String(row[4] || '').trim();
        if (rowLocation && !existingSlotLocation) {
          existingSlotLocation = rowLocation;
        }

        var rowIs1on1 = false;
        for (var sc = 0; sc < servicesConfig.length; sc++) {
          if (servicesConfig[sc].name.toLowerCase() === rowService.toLowerCase()) {
            rowIs1on1 = servicesConfig[sc].is1on1;
            break;
          }
        }
        if (!rowIs1on1) {
          rowIs1on1 = (rowService.toLowerCase().indexOf('1-1') !== -1 || 
                       rowService.toLowerCase().indexOf('indywidualny') !== -1 || 
                       rowService.toLowerCase().indexOf('konsultacj') !== -1);
        }

        if (rowIs1on1) {
          existing1on1 = true;
        } else {
          existingGroupCount++;
        }
      }
    }

    // 1. Jeśli w tym slocie jest już rezerwacja 1-1 / konsultacja -> brak miejsc
    if (existing1on1) {
      lock.releaseLock();
      return ContentService.createTextOutput(JSON.stringify({
        status: 'conflict',
        message: 'Termin ' + requestedDate + ' o godz. ' + requestedTime + ' jest już zajęty (zajęcia indywidualne)!'
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // 2. Jeśli klient chce zajęcia 1-1, a są już zapisane inne psy -> konflikt
    if (is1on1 && existingTotal > 0) {
      lock.releaseLock();
      return ContentService.createTextOutput(JSON.stringify({
        status: 'conflict',
        message: 'W wybranym terminie (' + requestedTime + ') trwają już inne zajęcia. Nie można zarezerwować zajęć 1-1 w tym slocie.'
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // 3. Sprawdzenie spójności rodzaju zajęć w slocie grupowym
    if (!is1on1 && existingTotal > 0) {
      for (var chk = 1; chk < allRows.length; chk++) {
        var r = allRows[chk];
        var rDate = formatSheetDate(r[0], tz);
        var rTime = formatSheetTime(r[2], tz);
        if (rDate === requestedDate && rTime === requestedTime) {
          var rService = String(r[3] || '').trim();
          if (rService && rService.toLowerCase() !== requestedService) {
            lock.releaseLock();
            return ContentService.createTextOutput(JSON.stringify({
              status: 'conflict',
              message: 'W tym terminie odbywają się już inne zajęcia (' + rService + '). Nie można mieszać różnych rodzajów treningów w jednym slocie.'
            })).setMimeType(ContentService.MimeType.JSON);
          }
        }
      }
    }

    // 4. Sprawdzenie spójności lokalizacji dla spaceru grupowego
    var requestedLocation = String(data.location || '').trim();
    if (!is1on1 && existingSlotLocation && requestedLocation && existingSlotLocation.toLowerCase() !== requestedLocation.toLowerCase()) {
      lock.releaseLock();
      return ContentService.createTextOutput(JSON.stringify({
        status: 'conflict',
        message: 'Dla tego terminu wybrano już inną lokalizację spotkania: ' + existingSlotLocation + '. W zajęciach grupowych wszyscy uczestnicy spotykają się w tym samym miejscu.'
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // 5. Limit psów na dany slot
    if (!is1on1 && existingGroupCount >= maxDogs) {
      lock.releaseLock();
      return ContentService.createTextOutput(JSON.stringify({
        status: 'conflict',
        message: 'Brak wolnych miejsc w tym terminie (limit ' + maxDogs + ' psów został osiągnięty)!'
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // Zapisujemy rezerwację do arkusza z prefiksem apostrofu
    sheet.appendRow([
      "'" + requestedDate,
      data.dateDisplay,
      "'" + requestedTime,
      data.serviceType,
      data.location,
      data.firstName,
      data.lastName,
      data.clientEmail,
      data.dogName,
      data.dogAge,
      data.dogGender,
      Utilities.formatDate(new Date(), tz, "yyyy-MM-dd HH:mm:ss")
    ]);

    // Tworzenie wydarzenia w Kalendarzu Google
    try {
      var dateParts = String(data.rawDate).trim().split('-');
      var year = parseInt(dateParts[0], 10);
      var month = parseInt(dateParts[1], 10) - 1;
      var day = parseInt(dateParts[2], 10);

      var timeParts = normalizeTime(String(data.timeSlot).trim()).split(':');
      var startHour = parseInt(timeParts[0], 10);
      var startMinute = parseInt(timeParts[1], 10);

      var startTime = new Date(year, month, day, startHour, startMinute, 0);
      var endTime = new Date(startTime.getTime() + 60 * 60 * 1000); // 1h

      var eventLocation = (data.location === 'Inna' ? data.otherLocation : data.location) || 'Warszawa Wawer';
      var eventTitle = 'PsiApsi: ' + data.serviceType + ' – ' + data.firstName + ' ' + data.lastName + ' (' + data.dogName + ')';
      
      var eventDescription = '🐶 Rezerwacja zajęć PsiApsi\n\n' +
                             '👤 Klient: ' + data.firstName + ' ' + data.lastName + '\n' +
                             '📧 E-mail: ' + (data.clientEmail || 'Brak') + '\n' +
                             '🐕 Pies: ' + data.dogName + ' (' + data.dogAge + ' lat, płeć: ' + data.dogGender + ')\n' +
                             '🎯 Rodzaj zajęć: ' + data.serviceType + '\n' +
                             '📍 Lokalizacja: ' + eventLocation + '\n' +
                             '📅 Data i godzina: ' + data.dateDisplay + ' o godz. ' + data.timeSlot;

      var calendar = CalendarApp.getDefaultCalendar();
      if (calendar) {
        try {
          var eventOptions = {
            description: eventDescription,
            location: eventLocation
          };
          if (data.clientEmail && String(data.clientEmail).indexOf('@') !== -1) {
            eventOptions.guests = String(data.clientEmail).trim();
            eventOptions.sendInvites = true;
          }
          calendar.createEvent(eventTitle, startTime, endTime, eventOptions);
        } catch (inviteErr) {
          calendar.createEvent(eventTitle, startTime, endTime, {
            description: eventDescription,
            location: eventLocation
          });
        }
      }
    } catch (calErr) {
      Logger.log("Błąd tworzenia wydarzenia w Google Calendar: " + calErr);
    }

    // E-mail z potwierdzeniem do klienta
    try {
      if (data.clientEmail) {
        MailApp.sendEmail({
          to: data.clientEmail,
          subject: 'Potwierdzenie rezerwacji - PsiApsi',
          body: 'Cześć ' + data.firstName + '!\n\nTwoja rezerwacja na dzień ' + data.dateDisplay + ' o godz. ' + data.timeSlot + ' (' + data.serviceType + ') w lokalizacji: ' + eventLocation + ' została przyjęta.\n\nPozdrawiamy,\nZespół PsiApsi'
        });
      }
    } catch (emailErr) {
      Logger.log("Błąd e-mail: " + emailErr);
    }

    lock.releaseLock();
    return ContentService.createTextOutput(JSON.stringify({ status: 'success' }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    lock.releaseLock();
    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doGet(e) {
  try {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var bookingsSheet = spreadsheet.getSheetByName("Rezerwacje") || spreadsheet.getActiveSheet();
    var tz = spreadsheet.getSpreadsheetTimeZone() || "Europe/Warsaw";
    var bookingsData = bookingsSheet.getDataRange().getValues();

    // 1. Pobieramy zarezerwowane sloty
    var bookedSlots = [];
    for (var i = 1; i < bookingsData.length; i++) {
      var row = bookingsData[i];
      var rowDate = formatSheetDate(row[0], tz);
      var rowTime = formatSheetTime(row[2], tz);
      var serviceType = String(row[3] || '').trim();
      var location = String(row[4] || '').trim();

      if (rowDate && rowTime) {
        bookedSlots.push({
          date: rowDate,
          timeSlot: rowTime,
          serviceType: serviceType,
          location: location
        });
      }
    }

    // 2. Pobieramy dynamiczną listę Usług (zakładka "Uslugi")
    var services = getServicesConfig(spreadsheet);

    // 3. Pobieramy dynamiczny grafik godzin (zakładka "Grafik")
    var schedule = getScheduleConfig(spreadsheet);

    var response = {
      status: 'success',
      bookedSlots: bookedSlots,
      services: services,
      schedule: schedule
    };

    return ContentService.createTextOutput(JSON.stringify(response))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// ── Odczyt zakładki "Uslugi" ──────────────────────────────────────────
// Kolumny: Nazwa | Ikona | Opis | Maks. psów | Blokuje slot (TAK/NIE) | Domyślne lokalizacje (oddzielone średnikiem lub przecinkiem)
function getServicesConfig(spreadsheet) {
  var sheet = spreadsheet.getSheetByName("Uslugi");
  if (!sheet) {
    return [
      {
        id: "1-1",
        name: "Spacer 1-1",
        icon: "🦮",
        desc: "Indywidualny, 1 pies",
        maxDogs: 1,
        is1on1: true,
        locations: ["Warszawa Wawer (trasy leśne MPK)"]
      },
      {
        id: "grupowy",
        name: "Spacer grupowy",
        icon: "🐕‍🦺",
        desc: "Do 3 psów, socjalizacja",
        maxDogs: 3,
        is1on1: false,
        locations: ["Warszawa Wawer (trasy leśne MPK)"]
      },
      {
        id: "konsultacja",
        name: "Konsultacja",
        icon: "🎓",
        desc: "Behawioralna, diagnoza",
        maxDogs: 1,
        is1on1: true,
        locations: ["Warszawa Wawer (trasy leśne MPK)", "Dojazd do klienta"]
      }
    ];
  }

  var data = sheet.getDataRange().getValues();
  var services = [];
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var name = String(row[0] || '').trim();
    if (!name) continue;

    var icon = String(row[1] || '🐾').trim();
    var desc = String(row[2] || '').trim();
    var maxDogs = parseInt(row[3], 10) || 1;
    var is1on1Val = String(row[4] || '').trim().toUpperCase();
    var is1on1 = (is1on1Val === 'TAK' || is1on1Val === 'TRUE' || is1on1Val === '1' || maxDogs === 1);
    
    var locRaw = String(row[5] || '').trim();
    var locations = [];
    if (locRaw) {
      locations = locRaw.split(/[;,]/).map(function(l) { return l.trim(); }).filter(Boolean);
    }
    if (locations.length === 0) {
      locations = ["Warszawa Wawer (trasy leśne MPK)"];
    }

    services.push({
      id: "service_" + i,
      name: name,
      icon: icon,
      desc: desc,
      maxDogs: maxDogs,
      is1on1: is1on1,
      locations: locations
    });
  }

  return services.length > 0 ? services : [
    {
      id: "1-1",
      name: "Spacer 1-1",
      icon: "🦮",
      desc: "Indywidualny, 1 pies",
      maxDogs: 1,
      is1on1: true,
      locations: ["Warszawa Wawer (trasy leśne MPK)"]
    }
  ];
}

// ── Odczyt zakładki "Grafik" ──────────────────────────────────────────
// Kolumny: Dzień tygodnia (Poniedziałek / YYYY-MM-DD) | Dostępne godziny (np. "18:00, 19:00, 20:00")
function getScheduleConfig(spreadsheet) {
  var sheet = spreadsheet.getSheetByName("Grafik");
  var defaultHours = ['18:00', '19:00', '20:00'];
  if (!sheet) {
    return {
      defaultHours: defaultHours,
      days: {}
    };
  }

  var tz = spreadsheet.getSpreadsheetTimeZone() || "Europe/Warsaw";
  var data = sheet.getDataRange().getValues();
  var daysConfig = {};
  var generalDefault = defaultHours;

  for (var i = 1; i < data.length; i++) {
    var rawKey = data[i][0];
    if (rawKey === undefined || rawKey === null || String(rawKey).trim() === '') continue;

    // Obsługa daty zapisanej jako obiekt Date w arkuszu
    var key = '';
    if (rawKey instanceof Date || (typeof rawKey === 'object' && typeof rawKey.getTime === 'function')) {
      key = Utilities.formatDate(rawKey, tz, "yyyy-MM-dd");
    } else {
      key = String(rawKey).trim().toLowerCase();
    }

    var hoursRaw = String(data[i][1] || '').trim();
    var hoursList = [];
    if (hoursRaw) {
      hoursList = hoursRaw.split(/[;,]/).map(function(h) {
        return normalizeTime(h.trim());
      }).filter(Boolean);
    }

    if (key === 'domyślne' || key === 'domyslne' || key === 'default') {
      if (hoursList.length > 0) generalDefault = hoursList;
    } else {
      // Przypisujemy listę (nawet jeśli pusta, co oznacza dzień wolny / brak terminów)
      daysConfig[key] = hoursList;
    }
  }

  return {
    defaultHours: generalDefault,
    days: daysConfig
  };
}

// Bezpieczne formatowanie daty z arkusza
function formatSheetDate(val, tz) {
  if (!val) return '';
  if (val instanceof Date || (typeof val === 'object' && typeof val.getTime === 'function')) {
    return Utilities.formatDate(val, tz, "yyyy-MM-dd");
  }
  var str = String(val).trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) {
    return str;
  }
  var parsed = new Date(str);
  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(parsed, tz, "yyyy-MM-dd");
  }
  return str;
}

// Bezpieczne formatowanie godziny z arkusza
function formatSheetTime(val, tz) {
  if (!val) return '';
  if (val instanceof Date || (typeof val === 'object' && typeof val.getHours === 'function')) {
    return Utilities.formatDate(val, tz, "HH:mm");
  }
  var str = String(val).trim();
  return normalizeTime(str);
}

function normalizeTime(str) {
  if (!str) return '';
  if (/^\d{1,2}:\d{2}$/.test(str)) {
    return str.length === 4 ? '0' + str : str;
  }
  var match = str.match(/(\d{1,2}):(\d{2})(?::\d{2})?/);
  if (match) {
    var h = match[1].length === 1 ? '0' + match[1] : match[1];
    return h + ':' + match[2];
  }
  return str;
}