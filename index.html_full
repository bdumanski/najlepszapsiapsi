<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PsiApsi - Spacery i kursy dla psów</title>
  <link rel="stylesheet" href="styles/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="index.html">PsiApsi</a>
      <nav class="site-nav">
        <a href="index.html">Home</a>
        <a href="walks.html">Spacery</a>
        <a href="courses.html">Kursy</a>
        <a href="about.html">O nas</a>
        <a href="contact.html">Kontakt</a>
      </nav>
      <a class="button button--secondary" href="#booking">Umów spotkanie</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Spacery i kursy dla psów</span>
          <h1>Twój pies zasługuje na bezpieczne spacery i przemyślane szkolenie</h1>
          <p>Budujemy relacje poprzez zabawę, systematyczne treningi i indywidualne podejście. Z nami każdy spacer staje się przyjemnością.</p>
          <div class="hero-actions">
            <a class="button" href="walks.html">Zobacz spacery</a>
            <a class="button button--ghost" href="courses.html">Poznaj kursy</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-panel">
            <p class="hero-panel__label">Wsparcie</p>
            <h2>Profesjonalny opiekun</h2>
            <p>Bezpieczeństwo, zabawa i zrozumienie potrzeb każdego psa.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="services container">
      <div class="section-header">
        <span class="eyebrow">Nasze usługi</span>
        <h2>Spacery, kursy i opieka dla psów</h2>
      </div>
      <div class="cards-grid">
        <article class="card">
          <h3>Spacery dostosowane</h3>
          <p>Zapewniamy trasy i tempo idealne dla Twojego psa. Bezpieczne grupy i indywidualna opieka.</p>
          <a href="walks.html" class="card-link">Szczegóły</a>
        </article>
        <article class="card">
          <h3>Kursy treningowe</h3>
          <p>Kursy podstawowe, zaawansowane i specjalne, które poprawiają zachowanie oraz pewność siebie psa.</p>
          <a href="courses.html" class="card-link">Szczegóły</a>
        </article>
        <article class="card">
          <h3>Opieka i hotelik</h3>
          <p>Komfortowe warunki, indywidualne podejście i aktywności, które sprawiają, że Twój pupil wraca szczęśliwy.</p>
          <a href="contact.html" class="card-link">Szczegóły</a>
        </article>
      </div>
    </section>

    <section class="stats">
      <div class="container stats-grid">
        <div class="stat">
          <p class="stat-value">2340+</p>
          <p class="stat-label">zadowolonych psów</p>
        </div>
        <div class="stat">
          <p class="stat-value">4,9/5</p>
          <p class="stat-label">ocena klientów</p>
        </div>
        <div class="stat">
          <p class="stat-value">970</p>
          <p class="stat-label">dzieci w hoteliku</p>
        </div>
      </div>
    </section>

    <section class="about container">
      <div class="about-grid">
        <div>
          <span class="eyebrow">Poznajmy się</span>
          <h2>Jesteśmy zespołem, który rozumie potrzeby psów i ich opiekunów</h2>
          <p>Tworzymy programy szkoleniowe oparte na pozytywnych metodach, które budują zaufanie i pozwalają psu i właścicielowi odnaleźć wspólny język.</p>
        </div>
        <div class="about-card">
          <p class="about-card__label">Radość i spokój</p>
          <p>Nasze spacery i kursy łączą aktywność z nauką, a opiekunowie otrzymują wsparcie w budowaniu codziennych nawyków.</p>
        </div>
      </div>
    </section>

    <section class="cta container">
      <div class="cta-panel">
        <div>
          <span class="eyebrow">Zacznij już dziś</span>
          <h2>Umów spacer lub kurs i zobacz różnicę</h2>
        </div>
        <a href="#booking" class="button">Umów spotkanie</a>
      </div>
    </section>

    <section class="location-map container" aria-label="Mapa lokalizacji spacerów">
      <div class="map-card">
        <div class="map-card__content">
          <span class="eyebrow">Lokalizacja spacerów</span>
          <h2>Spacery odbywają się na Wawrze</h2>
          <p>Nasze spacery prowadzone są głównie w dzielnicy Warszawa Wawer. Po indywidualnym ustaleniu mogą odbyć się w innej lokalizacji.</p>
        </div>
        <div class="map-placeholder">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d514.0288211609258!2d21.196711011334042!3d52.2043774285533!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ed3001c8d6049%3A0x993fdca456ff1219!2zxZpjaWXFvGthIGJpZWdvd2EgTWnEmWR6eWxlc2ll!5e0!3m2!1spl!2spl!4v1776359476821!5m2!1spl!2spl" width="400" height="300" style="border:0; width:100%; height:100%;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <!-- TYGODNIOWY KALENDARZ I FORMULARZ REZERWACJI -->
    <section id="booking" class="booking container" aria-labelledby="booking-heading">
      <div class="section-header">
        <span class="eyebrow">Grafik & Rezerwacja</span>
        <h2 id="booking-heading">Wybierz dogodny termin w grafiku tygodniowym</h2>
      </div>
      
      <div class="week-calendar-container">
        <div class="week-calendar-header">
          <button class="calendar-nav" id="prevWeek" aria-label="Poprzedni tydzień">‹ Poprzedni tydzień</button>
          <div class="week-title-wrap">
            <h3 class="week-title" id="weekRangeLabel">Tydzień ...</h3>
            <span class="calendar-subtitle">Zaznacz wolny slot godzinowy, aby wypełnić formularz</span>
          </div>
          <button class="calendar-nav" id="nextWeek" aria-label="Następny tydzień">Następny tydzień ›</button>
        </div>

        <!-- Legenda statusów -->
        <div class="week-legend" aria-label="Legenda statusów terminów">
          <span class="legend-item">
            <span class="legend-dot available"></span>
            <strong>Wolny termin</strong>
          </span>
          <span class="legend-item">
            <span class="legend-dot partial"></span>
            <strong>Spacer grupowy</strong> (są wolne miejsca)
          </span>
          <span class="legend-item">
            <span class="legend-dot full"></span>
            <strong>Zajęty / Brak miejsc</strong>
          </span>
          <span class="legend-item">
            <span class="legend-dot past"></span>
            <strong>Termin miniony</strong>
          </span>
        </div>

        <!-- Pasek wyboru dnia dla urządzeń mobilnych -->
        <div class="mobile-day-picker" id="mobileDayPicker" aria-label="Wybierz dzień tygodnia">
          <!-- Generowane przez JS -->
        </div>
        <div class="mobile-day-nav" id="mobileDayNav">
          <button type="button" class="mobile-day-nav-btn" id="prevDayBtn" aria-label="Poprzedni dzień">‹</button>
          <span class="mobile-day-nav-title" id="mobileDayTitle">Dzień</span>
          <button type="button" class="mobile-day-nav-btn" id="nextDayBtn" aria-label="Następny dzień">›</button>
        </div>

        <!-- Siatka tygodniowa -->
        <div class="week-grid" id="weekGrid">
          <!-- Wypełniane przez JS -->
        </div>
      </div>

      <div class="booking-panel" style="margin-top: 2rem;">
        <aside class="booking-summary" id="bookingSummary" style="width: 100%;">
          <span class="eyebrow">Formularz zgłoszeniowy</span>
          <h3 id="selectedDate">Kliknij wolny slot na grafice powyżej</h3>
          <p id="selectedInfo" style="margin-bottom: 1.5rem;">Możesz też wybrać dane z rozwijanych list poniżej.</p>
          
          <form id="bookingForm" class="booking-form">
            <div class="form-grid-2col">
              <div class="form-group">
                <label for="firstName">Imię</label>
                <input type="text" id="firstName" name="firstName" placeholder="Imię" required autocomplete="given-name">
              </div>

              <div class="form-group">
                <label for="lastName">Nazwisko</label>
                <input type="text" id="lastName" name="lastName" placeholder="Nazwisko" required autocomplete="family-name">
              </div>

              <div class="form-group">
                <label for="clientEmail">Adres e-mail</label>
                <input type="email" id="clientEmail" name="clientEmail" placeholder="twoj@email.pl" required autocomplete="email">
              </div>

              <div class="form-group">
                <label for="dogName">Imię psa</label>
                <input type="text" id="dogName" name="dogName" placeholder="Imię psa" required>
              </div>

              <div class="form-group">
                <label for="dogAge">Wiek psa (w latach)</label>
                <input type="number" id="dogAge" name="dogAge" placeholder="Wiek psa" min="0" max="20" required>
              </div>

              <div class="form-group">
                <label for="dogGender">Płeć psa</label>
                <select id="dogGender" name="dogGender" required>
                  <option value="" disabled selected>Wybierz płeć</option>
                  <option value="suka">Suka</option>
                  <option value="pies">Pies</option>
                </select>
              </div>

              <div class="form-group">
                <label for="bookingDateInput">Data zajęć</label>
                <input type="date" id="bookingDateInput" name="rawDate" required>
              </div>

              <div class="form-group">
                <label for="timeSlot">Godzina</label>
                <select id="timeSlot" name="timeSlot" required>
                  <option value="" disabled selected>Wybierz godzinę</option>
                  <option value="18:00">18:00</option>
                  <option value="19:00">19:00</option>
                  <option value="20:00">20:00</option>
                </select>
              </div>

              <div class="form-group">
                <label for="serviceType">Rodzaj zajęć</label>
                <select id="serviceType" name="serviceType" required>
                  <option value="" disabled selected>Wybierz rodzaj</option>
                  <option value="Spacer 1-1">Spacer 1-1</option>
                  <option value="Spacer grupowy">Spacer grupowy (do 3 psów)</option>
                  <option value="Konsultacja">Konsultacja</option>
                </select>
              </div>

              <div class="form-group">
                <label for="locationSelect">Lokalizacja</label>
                <select id="locationSelect" name="location" required>
                  <option value="Wawer" selected>Wawer</option>
                  <option value="Inna">Inna</option>
                </select>
              </div>
            </div>

            <div class="form-group hidden" id="otherLocationLabel" style="margin-top: 1rem;">
              <label for="otherLocation">Proponowana lokalizacja</label>
              <input type="text" id="otherLocation" name="otherLocation" placeholder="Wpisz lokalizację">
            </div>

            <button class="button" type="submit" id="bookingButton" style="margin-top: 1.5rem; width: 100%;">Zapisz się na wybrane zajęcia</button>
          </form>
        </aside>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p>© 2026 PsiApsi. Wszystkie prawa zastrzeżone.</p>
      <nav class="footer-nav">
        <a href="about.html">O nas</a>
        <a href="contact.html">Kontakt</a>
        <a href="walks.html">Spacery</a>
      </nav>
    </div>
  </footer>
  <script src="scripts/main.js"></script>
</body>
</html>
